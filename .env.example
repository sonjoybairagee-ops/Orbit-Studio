# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://esiiawfjzmuqplzzdoog.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session/licence signing for the website (openssl rand -hex 32)
LICENSE_JWT_SECRET=change-me-to-a-64-char-random-string

# bKash (manual) — the number shown on the checkout page
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX

# Paddle (global card payments)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

# Email (Resend) — optional; the app works without it, emails are just skipped
RESEND_API_KEY=
EMAIL_FROM=CompX Orbit <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# NOT set here — these live elsewhere:
#
#   LICENSE_PRIVATE_KEY   Supabase Edge Function secret only. Set it with
#                         `supabase secrets set --env-file keys/secrets.env`
#                         after running `npm run keys`. It must never appear
#                         in this file, in the website, or in the extension.
#
#   GOOGLE_CLIENT_ID      Supabase Dashboard -> Authentication -> Providers
#   GOOGLE_CLIENT_SECRET  -> Google. Not read by Next.js.
# ---------------------------------------------------------------------------
